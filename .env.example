# Copiá este archivo como .env y completá los valores
PORT=3000
ADMIN_PASSWORD=cambiame_por_una_clave_segura

# --- Bot de WhatsApp (API oficial de Meta). Sin estas variables el bot queda apagado. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=inventá_una_palabra_secreta
WHATSAPP_APP_SECRET=
ANTHROPIC_API_KEY=
# Número de Lauti para recibir avisos (formato 5491123456789, sin +)
LAUTI_WHATSAPP=
# Opcionales
# BOT_ACTIVO=no            # apaga el bot sin borrar nada
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
